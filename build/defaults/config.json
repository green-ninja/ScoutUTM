{
  "version": 2,
  "system": {
    "hostname": "scoututm",
    "timezone": "UTC",
    "admin_hash": "",
    "setup_done": false,
    "language": "en",
    "ntp_servers": ["pool.ntp.org"]
  },
  "network": {
    "interfaces": [
      {"name": "eth0", "zone": "wan", "type": "ethernet", "ipv4_mode": "dhcp"},
      {"name": "eth1", "zone": "lan", "type": "ethernet", "ipv4_mode": "static", "ipv4_address": "172.16.0.1/24"}
    ],
    "zones": [
      {"name": "wan", "input_policy": "drop", "forward_policy": "drop", "output_policy": "accept", "masquerade": true},
      {"name": "lan", "input_policy": "accept", "forward_policy": "accept", "output_policy": "accept", "masquerade": false}
    ],
    "vlans": []
  },
  "firewall": {
    "forwardings": [
      {"src": "lan", "dest": "wan"}
    ],
    "rules": [
      {"name": "Block Telnet", "src": "lan", "dest": "wan", "proto": "tcp", "port": 23, "action": "drop"},
      {"name": "Block SMB", "src": "lan", "dest": "wan", "proto": "tcp", "port": 445, "action": "drop"},
      {"name": "Block NetBIOS", "src": "lan", "dest": "wan", "proto": "tcp", "port": 139, "action": "drop"},
      {"name": "Block RPC", "src": "lan", "dest": "wan", "proto": "tcp", "port": 135, "action": "drop"}
    ],
    "port_forwards": []
  },
  "dns": {
    "upstream": ["1.1.1.1", "9.9.9.9"],
    "use_dot": true,
    "block_threats": true,
    "query_logging": true,
    "custom_block": [],
    "custom_allow": []
  },
  "vpn": {
    "wireguard": {
      "enabled": false,
      "listen_port": 51820,
      "address": "10.0.0.1/24",
      "tunnel_subnet": "10.0.0.0/24",
      "peers": []
    }
  },
  "ids": {
    "enabled": true,
    "mode": "ids",
    "rulesets": ["et-open", "abuse-ch"],
    "home_net": ["172.16.0.0/24"],
    "suppressed": []
  },
  "parental": {
    "profiles": [
      {
        "id": "default-kids",
        "name": "Kids",
        "block_categories": ["adult", "gambling", "gaming", "social_media", "streaming"],
        "safe_search": true,
        "youtube_restricted": true,
        "schedule": {"enabled": false, "start_time": "", "end_time": "", "days": []}
      }
    ],
    "devices": []
  },
  "update": {
    "auto_check": true,
    "auto_install": false,
    "channel": "stable",
    "server_url": "https://update.scoututm.com"
  }
}
