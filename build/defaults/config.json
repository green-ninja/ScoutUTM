{
  "version": 1,
  "system": {
    "hostname": "scoututm",
    "timezone": "UTC",
    "admin_hash": "",
    "setup_done": false,
    "language": "en",
    "ntp_servers": ["pool.ntp.org"]
  },
  "network": {
    "interfaces": [
      {"name": "eth0", "zone": "wan", "type": "ethernet", "ipv4_mode": "dhcp"},
