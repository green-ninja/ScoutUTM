# dnsmasq.conf — generated by scoutd, do not edit manually.
# DNS disabled — Unbound handles all DNS resolution.
port=0
bind-interfaces
dhcp-authoritative
dhcp-leasefile={{.LeaseFile}}
{{- range .Interfaces}}

# Interface: {{.Name}}
interface={{.Name}}
dhcp-range={{.Name}},{{.DHCPStart}},{{.DHCPEnd}},{{.Netmask}},{{.LeaseTime}}
dhcp-option={{.Name}},3,{{.IP}}
dhcp-option={{.Name}},6,{{.IP}}
{{- end}}
{{- if .StaticHosts}}

# Static DHCP reservations for parental controls.
{{- range .StaticHosts}}
dhcp-host={{.MAC}},{{.IP}}
{{- end}}
{{- end}}
