# unbound.conf — generated by scoutd, do not edit manually.
server:
    interface: {{.ListenAddr}}
    port: {{.Port}}
    do-daemonize: no
    use-syslog: no
    logfile: "/var/lib/scout/logs/dns-query.log"
    verbosity: 1
{{- range .AccessNets}}
    access-control: {{.}} allow
{{- end}}
    access-control: 127.0.0.0/8 allow
    access-control: 0.0.0.0/0 refuse

    # DNSSEC
{{- if .DNSSEC}}
    auto-trust-anchor-file: "/var/lib/unbound/root.key"
{{- end}}

    # Query logging
{{- if .QueryLogging}}
    log-queries: no
    log-replies: yes
{{- else}}
    log-queries: no
    log-replies: no
{{- end}}

{{- if .HasRPZ}}

    # Module config — respip required for RPZ
    module-config: "respip validator iterator"
{{- end}}

    # Hardening
    hide-identity: yes
    hide-version: yes
    harden-glue: yes
    harden-dnssec-stripped: yes
    harden-referral-path: yes
    use-caps-for-id: yes

    # Performance
    num-threads: 2
    msg-cache-size: 8m
    rrset-cache-size: 16m
    cache-min-ttl: 60
    cache-max-ttl: 86400
    prefetch: yes

{{- if .CustomAllow}}

    # Custom allow — domain overrides (bypass RPZ)
{{- range .CustomAllow}}
    local-zone: "{{.}}" transparent
{{- end}}
{{- end}}

{{- if .CustomBlock}}

    # Custom block — user-defined blocked domains
{{- range .CustomBlock}}
    local-zone: "{{.}}" always_nxdomain
{{- end}}
{{- end}}

{{- if .TagDefinition}}

    # Parental controls — profile tag definitions
    define-tag: "{{.TagDefinition}}"
{{- range .DeviceTags}}
    access-control-tag: {{.IP}}/32 "{{.Tag}}"
{{- end}}
{{- end}}

{{- if .SafeSearchOverrides}}

    # Safe search and YouTube restricted mode overrides
{{- range .SafeSearchOverrides}}
    local-zone: "{{.Domain}}" redirect
    local-zone-tag: "{{.Domain}}" "{{.Tags}}"
    local-data: "{{.Domain}} CNAME {{.Target}}"
{{- end}}
{{- end}}

{{- if .ScheduleBlockedIPs}}

    # Schedule-blocked devices — deny all DNS
{{- range .ScheduleBlockedIPs}}
    access-control: {{.}}/32 deny
{{- end}}
{{- end}}

{{- range .RPZZones}}

rpz:
    name: "{{.Name}}"
    zonefile: "{{.ZoneFile}}"
{{- end}}

{{- range .ParentalRPZZones}}

rpz:
    name: "{{.Name}}"
    zonefile: "{{.ZoneFile}}"
    tags: "{{.Tags}}"
{{- end}}

forward-zone:
    name: "."
{{- if .UseTLS}}
    forward-tls-upstream: yes
{{- end}}
{{- range .Upstreams}}
    forward-addr: {{.IP}}@{{.Port}}
{{- end}}
