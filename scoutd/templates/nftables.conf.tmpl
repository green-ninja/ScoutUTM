#!/usr/sbin/nft -f
# nftables.conf — generated by scoutd, do not edit manually.

flush ruleset

table inet scout {
{{- range .Zones}}
{{- $zone := .Name}}
{{- $ifaces := index $.ZoneInterfaces $zone}}
{{- if $ifaces}}
	set {{$zone}}_devices {
		type ifname
		elements = { {{join $ifaces ", "}} }
	}
{{- end}}
{{- end}}

	chain prerouting_raw {
		type filter hook prerouting priority raw; policy accept;
		# Drop all IPv6 traffic.
		meta nfproto ipv6 drop
	}

	chain prerouting {
		type nat hook prerouting priority dstnat; policy accept;
{{- range .Zones}}
{{- if ne .Name "wan"}}
{{- $ifaces := index $.ZoneInterfaces .Name}}
{{- if $ifaces}}
		# Redirect DNS from {{.Name}} zone to local resolver.
		iifname @{{.Name}}_devices udp dport 53 redirect
		iifname @{{.Name}}_devices tcp dport 53 redirect
{{- end}}
{{- end}}
{{- end}}
{{- if .VPN.Enabled}}
		# Redirect DNS from VPN clients to local resolver.
		iifname wg0 udp dport 53 redirect
		iifname wg0 tcp dport 53 redirect
{{- end}}
{{- range $i, $pf := .PortForwards}}
		# Port forward: {{$pf.Name}}
		iifname @wan_devices {{$pf.Proto}} dport {{$pf.SrcPort}} dnat to {{$pf.DestIP}}:{{$pf.DestPort}}
{{- end}}
	}

	chain input {
		type filter hook input priority filter; policy drop;

		ct state established,related accept
		iif lo accept
{{- range .Zones}}
{{- $ifaces := index $.ZoneInterfaces .Name}}
{{- if $ifaces}}
		iifname @{{.Name}}_devices jump input_{{.Name}}
{{- end}}
{{- end}}
{{- if .VPN.Enabled}}
		iifname wg0 jump input_vpn
{{- end}}
	}
{{range .Zones}}
{{- $zone := .}}
{{- $ifaces := index $.ZoneInterfaces .Name}}
{{- if $ifaces}}
	chain input_{{.Name}} {
{{- if ne .Name "wan"}}
		# Allow DHCP, DNS, ICMP on non-WAN zones.
		udp dport 67 accept
		tcp dport 53 accept
		udp dport 53 accept
		icmp type echo-request accept
		# Allow NTP.
		udp dport 123 accept
		# Allow HTTPS (web UI).
		tcp dport 443 accept
{{- if $.DevMode}}
		# Dev mode: allow SSH for Vagrant access.
		tcp dport 22 accept
{{- end}}
{{- end}}
{{- if eq .Name "wan"}}
{{- if $.VPN.Enabled}}
		# Allow WireGuard VPN.
		udp dport {{$.VPN.ListenPort}} accept
{{- end}}
{{- if $.DevMode}}
		# Dev mode: allow SSH and HTTPS on WAN for Vagrant access.
		tcp dport 22 accept
		tcp dport 443 accept
		tcp dport 80 accept
{{- end}}
{{- end}}
{{- if eq .InputPolicy "accept"}}
		accept
{{- else}}
		drop
{{- end}}
	}
{{- end}}
{{- end}}
{{- if .VPN.Enabled}}

	chain input_vpn {
		# Allow DNS, ICMP, NTP, HTTPS from VPN clients.
		tcp dport 53 accept
		udp dport 53 accept
		icmp type echo-request accept
		udp dport 123 accept
		tcp dport 443 accept
		accept
	}
{{- end}}

	chain forward {
		type filter hook forward priority filter; policy drop;

		ct state established,related accept
{{- if and .IDS.Enabled (eq .IDS.Mode "ips")}}
		jump ips
{{- end}}
{{- if .VPN.Enabled}}
		# Allow VPN clients to reach LAN and WAN.
		iifname wg0 oifname @wan_devices accept
{{- range .Zones}}
{{- if ne .Name "wan"}}
{{- $ifaces := index $.ZoneInterfaces .Name}}
{{- if $ifaces}}
		iifname wg0 oifname @{{.Name}}_devices accept
{{- end}}
{{- end}}
{{- end}}
{{- end}}
{{- range .Forwardings}}
{{- $src_ifaces := index $.ZoneInterfaces .Src}}
{{- $dest_ifaces := index $.ZoneInterfaces .Dest}}
{{- if and $src_ifaces $dest_ifaces}}
		iifname @{{.Src}}_devices oifname @{{.Dest}}_devices accept
{{- end}}
{{- end}}
{{- range .Rules}}
		# Rule: {{.Name}}
{{- if and .Port (ne .Proto "")}}
		iifname @{{.Src}}_devices oifname @{{.Dest}}_devices {{.Proto}} dport {{.Port}} {{.Action}}
{{- else}}
		iifname @{{.Src}}_devices oifname @{{.Dest}}_devices {{.Action}}
{{- end}}
{{- end}}
{{- if .PortForwards}}
		# Allow return traffic for port forwards.
		iifname @wan_devices ct status dnat accept
{{- end}}
	}
{{- if and .IDS.Enabled (eq .IDS.Mode "ips")}}

	chain ips {
		queue num 0-3 fanout,bypass
	}
{{- end}}

	chain postrouting {
		type nat hook postrouting priority srcnat; policy accept;
{{- range .Zones}}
{{- if .Masquerade}}
{{- $ifaces := index $.ZoneInterfaces .Name}}
{{- if $ifaces}}
		oifname @{{.Name}}_devices masquerade
{{- end}}
{{- end}}
{{- end}}
	}
}
